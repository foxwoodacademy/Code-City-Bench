{
  "mcp_server": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8766,
    "max_connections": 200,
    "timeout": 30,
    "ssl": {
      "enabled": false,
      "cert_path": "",
      "key_path": ""
    },
    "authentication": {
      "required": true,
      "api_keys": [
        "vibe-mcp-master-key-2024",
        "doctor-approved-access-2024",
        "races-winner-key-2024"
      ]
    },
    "load_balancing": {
      "enabled": true,
      "strategy": "round_robin",
      "health_check_interval": 60
    },
    "performance": {
      "max_workers": 40,
      "cache_size": 2048,
      "cache_ttl": 300
    },
    "logging": {
      "level": "debug",
      "file": "/storage/emulated/0/RootBase/logs/mcp_server.log",
      "max_size": 10485760,
      "backup_count": 5
