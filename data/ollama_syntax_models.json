      """,
      "purpose": "Swarm orchestration and coordination",
      "capabilities": [
        "Task distribution",
        "Conflict resolution",
        "Resource management",
        "Progress monitoring",
        "Result aggregation"
      ]
    },
    {
      "name": "codex-bridge",
      "template": """
FROM qwen2.5-coder:1.5b

PARAMETER temperature 0.5
PARAMETER num_predict 3072
PARAMETER num_ctx 6144

