#!/bin/bash
# CodeMentor CLI v2.0 — Analytics + Charts + AI
# SaaS-ready: usage tracking, tier gating hooks

BASE="/storage/emulated/0/RootBase/CodeMentor-MVP"
CONFIG="$BASE/config/api.json"
CACHE="$BASE/cache"
ANALYTICS="$BASE/analytics"

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; PURPLE='\033[0;35m'; NC='\033[0m'

# --- USAGE TRACKING (for SaaS billing later) ---
log_usage() {
    local cmd="$1" file="$2"
    local logfile="$ANALYTICS/usage_$(date +%Y%m).jsonl"
    echo "{\"ts\":\"$(date -Iseconds)\",\"cmd\":\"$cmd\",\"file\":\"$file\",\"device\":\"$(uname -a | base64 | head -c20)\"}" >> "$logfile"
}

setup() {
    echo -e "${CYAN}╔══════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     CodeMentor SaaS Setup v2.0       ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════╝${NC}"
    echo ""
    echo "Select AI Provider:"
    echo "  [1] Gemini (free tier: 1500 req/day)"
    echo "  [2] OpenRouter (pay-as-you-go, 100+ models)"
    echo ""
    echo -n "Choice [1/2]: "
    read -r choice
    
    if [[ "$choice" == "2" ]]; then
        echo -n "OpenRouter API Key: "
        read -r key
        echo -n "Model [anthropic/claude-3.5-sonnet]: "
        read -r model
        model=${model:-anthropic/claude-3.5-sonnet}
        echo "{\"provider\":\"openrouter\",\"api_key\":\"$key\",\"model\":\"$model\"}" > "$CONFIG"
    else
        echo -n "Gemini API Key: "
        read -r key
        echo -n "Model [gemini-2.0-flash]: "
        read -r model
        model=${model:-gemini-2.0-flash}
        echo "{\"provider\":\"gemini\",\"api_key\":\"$key\",\"model\":\"$model\"}" > "$CONFIG"
    fi
    
    mkdir -p "$CACHE" "$ANALYTICS"
    echo -e "${GREEN}[+] Config saved${NC}"
    echo -e "${YELLOW}[!] Keys stored locally only. Never committed.${NC}"
}

show_help() {
    cat << 'HELP'
CodeMentor CLI v2.0 — SaaS Analytics Edition

USAGE:
  mentor <file>                    Full AI explanation + analytics + charts
  mentor <file> 10 25              Explain lines 10-25 only
  mentor <file> --analytics-only   Static analysis only (no API cost)
  mentor <file> --chart            Generate complexity visualization
  mentor <file> --html             Raw HTML output (for webview/pipe)
  mentor --setup                   Configure API provider
  mentor --cache-clear             Wipe all caches
  mentor --report                  Show usage statistics
  mentor --serve                   Start local web dashboard (Termux)

EXAMPLES:
  mentor app.py
  mentor app.py --analytics-only | bat --language=html
  mentor app.py 50 100 --html > report.html
  mentor --serve &  # Opens dashboard at http://localhost:8080

SaaS TIERS (future):
  FREE: 50 explanations/month, basic analytics
  PRO: Unlimited + compare + quiz + team reports  
  ENTERPRISE: SSO + custom heuristics + SLA
HELP
}

# --- WEB DASHBOARD (micro server for Termux) ---
serve_dashboard() {
    local port="${1:-8080}"
    echo -e "${CYAN}[+] Starting dashboard on http://localhost:$port${NC}"
    echo -e "${YELLOW}[!] Press Ctrl+C to stop${NC}"
    
    python3 -c "
import http.server, socketserver, os, json, glob
from datetime import datetime

BASE = '$BASE'
ANALYTICS = BASE + '/analytics'

class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/':
            self.send_response(200)
            self.send_header('Content-type', 'text/html')
            self.end_headers()
            
            # Gather all analytics files
            reports = sorted(glob.glob(ANALYTICS + '/*.json'), reverse=True)[:20]
            rows = ''
            for r in reports:
                data = json.load(open(r))
                rows += f'<tr><td>{os.path.basename(r)}</td><td>{data.get(\\\"filepath\\\",\\\"?\\\")}</td><td>{data.get(\\\"total_lines\\\",0)}</td><td>{len(data.get(\\\"functions\\\",[]))}</td><td>{data.get(\\\"complexity_estimate\\\",0)}</td><td>{len(data.get(\\\"security_flags\\\",[]))}</td></tr>'
            
            html = f'''<!DOCTYPE html>
<html><head><meta charset=\"utf-8\"><title>CodeMentor Analytics</title>
<style>
body {{ background:#0f0f1e; color:#e0e0e0; font-family:monospace; padding:20px; }}
h1 {{ color:#00ff88; }} table {{ width:100%; border-collapse:collapse; margin-top:20px; }}
th,td {{ padding:10px; text-align:left; border-bottom:1px solid #333; }}
th {{ color:#00ff88; background:#1a1a2e; }}
tr:hover {{ background:#1a1a2e; }}
.metric {{ display:inline-block; background:#1a1a2e; padding:15px 25px; margin:10px; border-radius:8px; }}
.metric .num {{ font-size:2em; color:#00ff88; }}
</style></head><body>
<h1>📊 CodeMentor Analytics Dashboard</h1>
<div class=\"metric\"><span class=\"num\">{len(reports)}</span><div>Reports</div></div>
<div class=\"metric\"><span class=\"num\">{len(glob.glob(BASE+'/cache/*.json'))}</span><div>Cached</div></div>
<table><thead><tr><th>Report</th><th>File</th><th>Lines</th><th>Funcs</th><th>Complexity</th><th>Flags</th></tr></thead>
<tbody>{rows}</tbody></table>
<p style=\"margin-top:30px;color:#888;\">Generated: {datetime.now().isoformat()}</p>
</body></html>'''
            self.wfile.write(html.encode())
        elif self.path == '/api/stats':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            stats = {'reports': len(glob.glob(ANALYTICS + '/*.json')), 'cached': len(glob.glob(BASE + '/cache/*.json'))}
            self.wfile.write(json.dumps(stats).encode())
        else:
            self.send_error(404)
            
    def log_message(self, format, *args):
        pass  # Quiet

with socketserver.TCPServer((\"\", $port), Handler) as httpd:
    httpd.serve_forever()
" || echo -e "${RED}[!] Python server failed. Check python3.${NC}"
}

# --- MAIN ---
if [[ "$1" == "--setup" ]]; then setup; exit 0; fi
if [[ "$1" == "--help" || "$1" == "-h" || -z "$1" ]]; then show_help; exit 0; fi
if [[ "$1" == "--cache-clear" ]]; then rm -rf "$CACHE"/*; echo "Cache cleared."; exit 0; fi
if [[ "$1" == "--report" ]]; then 
    echo -e "${CYAN}=== USAGE LOG ===${NC}"
    cat "$ANALYTICS"/usage_*.jsonl 2>/dev/null | wc -l | xargs echo "Total requests:"
    ls -la "$ANALYTICS"/*.json 2>/dev/null | wc -l | xargs echo "Analytics reports:"
    exit 0
fi
if [[ "$1" == "--serve" ]]; then serve_dashboard "${2:-8080}"; exit 0; fi

HTML_OUT=false
EXTRA_FLAGS=""

while [[ "$1" == --* ]]; do
    case "$1" in
        --html) HTML_OUT=true; shift ;;
        --analytics-only) EXTRA_FLAGS="$EXTRA_FLAGS --analytics-only"; shift ;;
        --chart) EXTRA_FLAGS="$EXTRA_FLAGS --chart"; shift ;;
        *) shift ;;
    esac
done

FILE="$1"
START="${2:-}"
END="${3:-}"

[[ ! -f "$FILE" ]] && { echo -e "${RED}[!] File not found: $FILE${NC}"; exit 1; }

log_usage "explain" "$FILE"

if [[ -n "$START" && -n "$END" ]]; then
    RESULT=$(python3 "$BASE/lib/ai_explain.py" "$FILE" "$START" "$END" $EXTRA_FLAGS)
else
    RESULT=$(python3 "$BASE/lib/ai_explain.py" "$FILE" $EXTRA_FLAGS)
fi

if [[ "$HTML_OUT" == true ]]; then
    echo "$RESULT"
else
    # Terminal-friendly stripping with color hints
    echo "$RESULT" | sed \
        -e 's/<h[123][^>]*>/\n\x1b[1;32m/g' -e 's/<\/h[123]>/\x1b[0m\n/g' \
        -e 's/<li>/  • /g' -e 's/<\/li>//g' \
        -e 's/<code>/\x1b[33m/g' -e 's/<\/code>/\x1b[0m/g' \
        -e 's/<pre>/\n---\n\x1b[36m/g' -e 's/<\/pre>/\x1b[0m\n---\n/g' \
        -e 's/<[^>]*>//g' | grep -v '^$' | head -200
fi
